# Claudbot environment variables
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env        (macOS/Linux)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# The real ".env" is gitignored and must NEVER be committed.
# `claudbot onboard` writes most of these for you automatically.
# ---------------------------------------------------------------------------

# ── Fallback provider + sub-agents (required for fallback/channels/dream) ──
# Used when Claude Code hits its rate limit, and by NIM-based sub-agents.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL is only a last-resort default if the agents below aren't registered.
NIM_MODEL=moonshotai/kimi-k2.6

# ── Role agents (resolved by NAME from .claudbot/agents.yaml) ──
# Which registered sub-agent handles each background role. Defaults shown.
# The fallback REPL (when Claude hits its limit) and the dream loop deliberately
# use different agents so they never contend for the same model.
CLAUDBOT_FALLBACK_AGENT=agent        # NIM fallback REPL  (default: Kimi K2.6)
CLAUDBOT_DREAM_AGENT=researcher      # background dreaming (default: Nemotron 3 Ultra)
CLAUDBOT_SUMMARY_AGENT=fast          # `recall last` conversation summaries (default: Nemotron Nano)
CLAUDBOT_BRIEFING_AGENT=fast         # morning news curation (default: Nemotron Nano — Ultra is too slow)

# ── Sub-agent token controls (defaults shown; all optional) ──
# CLAUDBOT_AGENT_MAX_TOKENS=4096     # completion cap sent to sub-agent endpoints
                                     # (per-agent `maxTokens` in agents.yaml wins)
# CLAUDBOT_AGENT_MAX_OUTPUT=24000    # max chars of a sub-agent reply forwarded to
                                     # the caller (rest truncated with a notice)
# CLAUDBOT_AGENT_TIMEOUT_MS=300000   # sub-agent request timeout (the old 120s cap
                                     # regularly killed the bigger NIM models)

# ── Morning dashboard / briefing ──
CLAUDBOT_BRIEFING_INTERVAL_H=6       # hours between digest rebuilds in `briefing --watch`
DASHBOARD_PORT=4500                  # `claudbot dashboard` port
# Night VM (NUC). When set on the PC, every `claudbot` launch quietly pulls the
# VM's overnight dream log and merges the new entries into .claudbot/dream-log.md.
# CLAUDBOT_NIGHT_URL=http://192.168.1.150:4500
# Phase-2 personal connectors (not yet wired — see docs/morning-dashboard.md):
# GMAIL_TOKEN=
# GCAL_TOKEN=

# ── Notion (organizer task sync + the desktop To-do widget) ──
# Create an internal integration at https://www.notion.so/my-integrations,
# share your tasks database with it, then take the database id out of the
# database's URL. Both are required — either one alone leaves sync switched off.
# NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_TASKS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if your database uses non-default property names:
# NOTION_TITLE_PROP=Name
# NOTION_DONE_PROP=Done
# NOTION_DUE_PROP=Due

# ── Desktop widgets (docs/widgets.md) ──
# Free key from https://finnhub.io — 60 calls/min, plenty for 3 symbols.
# Without it the Stocks widget renders but shows "no key".
# FINNHUB_API_KEY=
CLAUDBOT_WIDGETS_STATUS_S=30         # seconds between status refreshes
CLAUDBOT_WIDGETS_TODO_S=30           # seconds between task refreshes
CLAUDBOT_WIDGETS_STOCKS_S=60         # seconds between quotes while the market is open
CLAUDBOT_WIDGETS_STOCKS_CLOSED_S=900 # …and while it's closed
# Agent usage is metered in tokens. Set a $/million-tokens rate to also show a
# cost figure on the Status widget; left unset it shows "—" rather than inventing
# a number for credit-based NIM endpoints.
# CLAUDBOT_USAGE_RATE_PER_MTOK=0.50

# ── Default behaviour ──
# full | auto | safe | readonly   (see README → Permission modes)
CLAUDBOT_DEFAULT_MODE=full

# ── Sub-agent API keys (optional) ──
# Only set the ones your agents.yaml actually references. Each agent picks
# its key by env-var NAME via `apiKeyEnv`. Local endpoints (Ollama, LM Studio,
# vLLM) need no key. Examples:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=
# DEEPINFRA_API_KEY=
# FIREWORKS_API_KEY=
# NVIDIA_API_KEY=

# ── Channels: WhatsApp via Twilio (optional) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Only these numbers get answered (comma-separated). Leave empty = anyone (unsafe).
WHATSAPP_ALLOWED_NUMBERS=

# ── Channels: Telegram (optional) ──
TELEGRAM_BOT_TOKEN=
# Only these chat IDs get answered (comma-separated). Leave empty = anyone (unsafe).
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional shared secret; set the same value via Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Channels: Discord / Slack (stored for future use) ──
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=

# ── Channel server ──
CHANNEL_PORT=3000

# ── Voice (claudbot voice) ──
# Full reference: voice/README.md. All optional — defaults shown.
# CLAUDBOT_VOICE_MIC_INDEX=            # from `claudbot voice devices`; blank = default
# CLAUDBOT_VOICE_SPEAKER_INDEX=
# CLAUDBOT_VOICE_LANGS=en-US,es-ES     # ordered; the first one is primary
# CLAUDBOT_VOICE_DUPLEX=half           # half = speakers-safe echo gate; full = headset + barge-in
# CLAUDBOT_VOICE_SILENCE_TAIL=0.9      # seconds of quiet that end a phrase
# CLAUDBOT_VOICE_WAKE_THRESHOLD=0.5    # raise for fewer false triggers
# CLAUDBOT_VOICE_PORT=4710             # voice control server
# CLAUDBOT_VOICE_CWD=                  # repo the voice agent works in (default: .claudbot)
# Kokoro TTS model files (download into voice/models/, or point at existing copies)
# CLAUDBOT_VOICE_KOKORO_MODEL=
# CLAUDBOT_VOICE_KOKORO_VOICES=
# NVIDIA Riva ASR (optional — Google fallback covers EN+ES without any of this).
# Stock parakeet-ctc-0.6b is en-US ONLY; for Spanish use the es/en code-switch or
# multilingual model and grab its function id from build.nvidia.com -> Deploy.
# CLAUDBOT_VOICE_ASR_FUNCTION_ID=
# CLAUDBOT_VOICE_ASR_FUNCTION_ID_ES=
# CLAUDBOT_VOICE_ASR_MULTILINGUAL=0    # 1 when the model handles both in one pass

# ── Screen awareness (claudbot screen) ──
# OFF by default. Captures are described by NIM vision, never by Claude.
# CLAUDBOT_SCREEN_INTERVAL_MIN=5       # heartbeat, minutes
# CLAUDBOT_SCREEN_AGENT=vision         # agent from agents.yaml used to describe frames
# CLAUDBOT_SCREEN_MONITOR=0            # 0 = primary; -1 = all monitors stitched

# ── Device control MCP ──
# ADB_PATH=                            # if adb isn't on PATH
# IDEVICE_PATH=                        # libimobiledevice tools directory

# ── Gemini (default research agent) ──
# Optional. The `gemini` agent runs through the Gemini CLI by default, which
# authenticates with an OAuth login (`gemini` once, interactively) and bills to
# your Google AI subscription rather than per token. Set this only if you also
# want the HTTP endpoint as a fallback for when the CLI is missing or logged out.
GEMINI_API_KEY=
