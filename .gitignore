# dependencies
node_modules/

# reference repos (not part of Claudbot)
openclaw-main/
NemoClaw-main/

# update command backups
.update-backup-*/

# logs
*.log

# secrets — never commit
.env

# generated / runtime files (machine-specific paths, regenerated on launch)
.claudbot/.mcp.json
.claudbot/channels.yaml
.claudbot/dream-log.md
.claudbot/dream-log.archive.md
.claudbot/channel-log.md
.claudbot/conversation-index.json
.claudbot/organizer.json
.claudbot/briefing.nuc.json
.claudbot/dream-log.nuc.md
.claudbot/.night-sync.json
.claudbot/.pid
.claudbot/.restart
.claudbot/usage.json
.claudbot/widgets/

# Rainmeter can't read an env var or resolve a relative path, so the skins need
# this machine's absolute paths written out. Generated by widgets/install.mjs.
widgets/skins/Claudbot/@Resources/paths.inc

# briefing digests (generated each run, machine-specific)
briefing/data/

# forge output: generated parts, previews, G-code. Large, binary, regenerable.
forge-out/

# voice subsystem: venv, downloaded/trained models, recorded samples
voice/.venv/
voice/models/
voice/__pycache__/
__pycache__/
*.pyc

# voice + screen runtime state
.claudbot/voice/
.claudbot/screen/

# per-project chat memory (machine-specific paths)
.claudbot/projects/
